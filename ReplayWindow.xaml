<Window x:Class="SoapProxyApp.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        Title="Replay Request" Height="600" Width="800" Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- URL and Method -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="TxtMethod" Grid.Column="0" Text="POST" Margin="0,0,5,0" FontWeight="Bold" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}" Padding="5"/>
            <TextBox Name="TxtUrl" Grid.Column="1" Text="http://example.com" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}" Padding="5"/>
        </Grid>

        <!-- Headers -->
        <GroupBox Header="Headers" Grid.Row="1" Margin="0,0,0,10" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}">
            <TextBox Name="TxtHeaders" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{DynamicResource EditorBg}" Foreground="{DynamicResource EditorFg}" BorderThickness="0" Padding="5"/>
        </GroupBox>

        <!-- Body -->
        <GroupBox Header="Body" Grid.Row="2" Margin="0,0,0,10" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}">
            <avalonEdit:TextEditor Name="TxtBody" FontFamily="Consolas" FontSize="13" ShowLineNumbers="True" Background="{DynamicResource EditorBg}" Foreground="{DynamicResource EditorFg}"/>
        </GroupBox>

        <!-- Action -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{DynamicResource AppButtonStyle}" Name="BtnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Style="{DynamicResource AppButtonStyle}" Name="BtnSend" Content="Send Request" Width="120" Height="30" FontWeight="Bold" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="BtnSend_Click"/>
        </StackPanel>
    </Grid>
</Window>

