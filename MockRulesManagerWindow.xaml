<Window x:Class="SoapProxyApp.MockRulesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mock Rules (Auto-Responder)" Height="450" Width="800" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Active Mock Rules (Bypass server and return fake responses)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextFg}" Margin="0,0,0,10"/>
        
        <DataGrid Name="GridRules" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource PanelBg}" Foreground="Black" RowBackground="{DynamicResource WindowBg}" AlternatingRowBackground="#FFE0E0E0" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <DataGridTextColumn Header="URL Match" Binding="{Binding UrlMatch}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Content-Type" Binding="{Binding ContentType}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="➕ Add New Rule" Width="120" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button Content="✏️ Edit Selected" Width="120" Height="30" Margin="0,0,10,0" Click="BtnEdit_Click"/>
            <Button Content="🗑 Delete Selected" Width="120" Height="30" Click="BtnDelete_Click" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>
