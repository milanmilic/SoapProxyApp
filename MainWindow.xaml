<Window x:Class="SoapProxyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        Title="SOAP Proxy App" Height="800" Width="1200" Background="{DynamicResource WindowBg}"
        Icon="app_icon.ico">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource EditorBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource EditorFg}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="{x:Type avalonEdit:TextEditor}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource EditorBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource EditorFg}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ShowLineNumbers" Value="True"/>
            <Setter Property="WordWrap" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold" Foreground="{DynamicResource TextFg}"/>
                    <TextBox Name="TxtPort" Text="8899" Width="60" Padding="2" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextFg}" IsReadOnly="False" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <CheckBox Name="ChkSystemProxy" Content="System Proxy" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource TextFg}" ToolTip="Capture ALL system HTTP/HTTPS traffic (like Fiddler)" />
                    <Button Name="BtnStart" Content="Start Proxy" Width="100" Height="30" Margin="0,0,10,0" Click="BtnStart_Click" FontWeight="Bold"/>
                    <Button Name="BtnStop" Content="Stop Proxy" Width="100" Height="30" IsEnabled="False" Click="BtnStop_Click"/>
                    <Button Name="BtnClear" Content="🗑 Clear All" Width="90" Height="30" Margin="10,0,0,0" Click="BtnClear_Click" Background="#FF9800" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                    <Button Name="BtnSave" Content="💾 Save" Width="80" Height="30" Margin="10,0,0,0" Click="BtnSave_Click"/>
                    <Button Name="BtnLoad" Content="📂 Load" Width="80" Height="30" Margin="5,0,0,0" Click="BtnLoad_Click"/>
                    <Button Name="BtnMock" Content="🎭 Mock Rules" Width="100" Height="30" Margin="15,0,0,0" Click="BtnMock_Click" Background="#2196F3" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                    <Button Name="BtnExportCert" Content="Install Cert" ToolTip="Installs to Local Machine (Requires Admin)" Width="100" Height="30" Margin="10,0,0,0" Click="BtnExportCert_Click"/>
                    
                    <Button Name="BtnTheme" Content="🌙 Dark Mode" Width="110" Height="30" Margin="15,0,0,0" Click="BtnTheme_Click"/>
                    <TextBlock Name="TxtStatus" Text="Proxy is stopped." VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="#D32F2F"/>
                </StackPanel>
                
                <TextBlock Name="TxtVersion" Text="v1.5.0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFg}" Opacity="0.5" FontWeight="SemiBold" FontSize="11" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Sessions List -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,5" Background="{DynamicResource PanelBg}" CornerRadius="2">
                    <Grid>
                        <TextBlock Text="🔍 Filter (URL, App, Method...)" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFg}" Opacity="0.5" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=TxtFilter}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Name="TxtFilter" Background="Transparent" Foreground="{DynamicResource TextFg}" BorderThickness="0" Padding="5" IsReadOnly="False" TextChanged="TxtFilter_TextChanged"/>
                    </Grid>
                </Border>

                <ListBox Name="LstSessions" Grid.Row="1" Margin="0" SelectionMode="Extended" SelectionChanged="LstSessions_SelectionChanged" KeyDown="LstSessions_KeyDown" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource PanelBg}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Replay / Resend Request" Click="MenuReplay_Click" FontWeight="Bold" />
                        <MenuItem Header="🎭 Mock this Endpoint..." Click="MenuMock_Click" FontWeight="Bold" Foreground="#2196F3" />
                        <MenuItem Header="Delete Selected" Click="MenuDelete_Click" Foreground="Red" />
                        <Separator />
                        <MenuItem Header="💾 Save Selected Session(s)..." Click="MenuSaveSelected_Click" />
                        <MenuItem Header="📂 Load Session(s)..." Click="MenuLoad_Click" />
                        <Separator />
                        <MenuItem Header="Compare Requests (VS Code / WinMerge)" Click="MenuCompareReq_Click" />
                        <MenuItem Header="Compare Responses (VS Code / WinMerge)" Click="MenuCompareRes_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemSelectedBg}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder" Margin="0,1" Padding="3,2" CornerRadius="3" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                            <StackPanel>
                                <TextBlock Text="{Binding Url}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ItemText}"/>
                                <TextBlock Foreground="{DynamicResource TextFg}" Opacity="0.7" FontSize="11" Margin="0,1,0,0">
                                    <Run Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" />
                                    <Run Text=" | Status: " />
                                    <Run Text="{Binding StatusCode}" FontWeight="Bold" />
                                    <Run Text=" | Method: " />
                                    <Run Text="{Binding Method}" />
                                    <Run Text=" | App: " />
                                    <Run Text="{Binding ProcessName}" />
                                    <Run Text=" | Length: " />
                                    <Run Text="{Binding FormattedLength, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding StatusCategory}" Value="Success">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SuccessBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusCategory}" Value="Error">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ErrorBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusCategory}" Value="Warning">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WarningBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemSelectedBg}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderColor}" ShowsPreview="True"/>

            <!-- Right Column: Details -->
            <Grid Grid.Column="2" Margin="5,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Request Details -->
                <GroupBox Header="REQUEST" Grid.Row="0" FontWeight="Bold" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Name="TxtReqSoapAction" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,5" FontWeight="Normal" Foreground="{DynamicResource TextFg}" Visibility="Collapsed" />
                        <Button Name="BtnExportReq" Content="💾 Export" Grid.Row="0" HorizontalAlignment="Right" Padding="15,3" Margin="0,0,0,5" Click="BtnExportReq_Click" Background="#2196F3" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <TabControl Name="ReqTabs" Grid.Row="1" Margin="0" FontWeight="Normal" SelectionChanged="ReqTabs_SelectionChanged" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderColor}">
                            <TabItem Header="Headers">
                                <TextBox Name="TxtReqHeaders" />
                            </TabItem>
                            <TabItem Header="Raw">
                                <avalonEdit:TextEditor Name="TxtReqRaw" />
                            </TabItem>
                            <TabItem Header="HTML">
                                <avalonEdit:TextEditor Name="TxtReqHtml" SyntaxHighlighting="HTML" />
                            </TabItem>
                            <TabItem Header="Image">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBg}">
                                    <Image Name="ImgReqImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Formatted XML">
                                <avalonEdit:TextEditor Name="TxtReqXmlFormatted" SyntaxHighlighting="XML" />
                            </TabItem>
                            <TabItem Header="JSON">
                                <avalonEdit:TextEditor Name="TxtReqJson" SyntaxHighlighting="JavaScript" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </GroupBox>

                <!-- Horizontal Splitter -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderColor}" ShowsPreview="True"/>

                <!-- Response Details -->
                <GroupBox Header="RESPONSE" Grid.Row="2" FontWeight="Bold" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Name="BtnExportRes" Content="💾 Export" Grid.Row="0" HorizontalAlignment="Right" Padding="15,3" Margin="0,0,0,2" Click="BtnExportRes_Click" Background="#2196F3" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                        <TabControl Name="ResTabs" Grid.Row="1" Margin="0" FontWeight="Normal" SelectionChanged="ResTabs_SelectionChanged" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderColor}">
                            <TabItem Header="Headers">
                                <TextBox Name="TxtResHeaders" />
                            </TabItem>
                            <TabItem Header="Raw">
                                <avalonEdit:TextEditor Name="TxtResRaw" />
                            </TabItem>
                            <TabItem Header="HTML">
                                <avalonEdit:TextEditor Name="TxtResHtml" SyntaxHighlighting="HTML" />
                            </TabItem>
                            <TabItem Header="Image">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBg}">
                                    <Image Name="ImgResImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" />
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Formatted XML">
                                <avalonEdit:TextEditor Name="TxtResXmlFormatted" SyntaxHighlighting="XML" />
                            </TabItem>
                            <TabItem Header="JSON">
                                <avalonEdit:TextEditor Name="TxtResJson" SyntaxHighlighting="JavaScript" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
