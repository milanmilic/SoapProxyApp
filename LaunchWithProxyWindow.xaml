<Window x:Class="SoapProxyApp.LaunchWithProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch with Proxy" Height="640" Width="820" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Launch a program that sends its HTTP/HTTPS traffic through SoapProxyApp" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Name="TxtIntro" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12"
                   Text="The program and every process it starts (e.g. F5 in Visual Studio, dotnet run) gets proxy environment variables. SOAP and REST calls from those processes appear in the list. The Windows System Proxy and other programs are not affected."/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Program:" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Name="CmbPreset" Height="28" Margin="0,0,0,6" VerticalContentAlignment="Center" SelectionChanged="CmbPreset_SelectionChanged"/>

            <TextBlock Grid.Row="1" Text="Executable:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="TxtPath" Height="28" Margin="0,0,6,6"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{DynamicResource AppButtonStyle}" Content="Browse..." Width="95" Height="28" Margin="0,0,0,6" Click="BtnBrowseExe_Click"/>

            <TextBlock Grid.Row="2" Text="Arguments:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="TxtArgs" Height="28" Margin="0,0,6,6" ToolTip="Optional. For Visual Studio, pick the solution (.sln/.slnx) to open."/>
            <Button Grid.Row="2" Grid.Column="2" Style="{DynamicResource AppButtonStyle}" Name="BtnBrowseArg" Content="File..." Width="95" Height="28" Margin="0,0,0,6" Click="BtnBrowseArg_Click"/>

            <TextBlock Grid.Row="3" Text="Working folder:" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Name="TxtWorkDir" Height="28" Margin="0,0,6,0" ToolTip="Optional. Defaults to the folder of the opened file or the executable."/>
            <Button Grid.Row="3" Grid.Column="2" Style="{DynamicResource AppButtonStyle}" Content="Folder..." Width="95" Height="28" Click="BtnBrowseDir_Click"/>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="3,0,0,0" Padding="8,6" Margin="0,4,0,8">
            <TextBlock Name="TxtHint" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Environment variables that will be set:" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Name="TxtEnvPreview" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" BorderThickness="1" Padding="6"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="Recent launches (double-click to launch again):" FontWeight="Bold" Margin="0,4,0,4"/>
        <ListBox Grid.Row="6" Name="LstRecent" DisplayMemberPath="Display" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextFg}" BorderBrush="{DynamicResource BorderColor}"
                 SelectionChanged="LstRecent_SelectionChanged" MouseDoubleClick="LstRecent_MouseDoubleClick"/>

        <Grid Grid.Row="7" Margin="0,10,0,0">
            <Button Style="{DynamicResource AppButtonStyle}" Content="Remove from recent" Width="150" Height="30" HorizontalAlignment="Left" Click="BtnRemoveRecent_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource AppButtonStyle}" Name="BtnLaunch" Content="🚀 Launch" Width="120" Height="30" Margin="0,0,10,0" FontWeight="Bold" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="BtnLaunch_Click" IsDefault="True"/>
                <Button Style="{DynamicResource AppButtonStyle}" Content="Close" Width="100" Height="30" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
