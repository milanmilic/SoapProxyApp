<?xml version="1.0"?>
<SyntaxDefinition name="LightXML" extensions=".xml" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <Color name="Name" foreground="Blue" />
    <Color name="Value" foreground="Red" />
    <Color name="Link" foreground="Purple" />
    <Color name="Punctuation" foreground="Black" />
    <RuleSet>
        <Span color="Value" multiline="true">
            <Begin>&lt;!--</Begin>
            <End>--&gt;</End>
        </Span>
        <Rule color="Link">&quot;https?://[^&quot;]*&quot;</Rule>
        <Rule color="Value">&quot;[^&quot;]*&quot;</Rule>
        <Rule color="Name">(?&lt;=&lt;/?)[A-Za-z0-9_:\.\-]+</Rule>
        <Rule color="Name">[A-Za-z0-9_:\.\-]+(?=\s*=)</Rule>
        <Rule color="Value">(?&lt;=&gt;)[^&lt;&gt;]+(?=&lt;)</Rule>
        <Rule color="Punctuation">[&lt;&gt;=/?]+</Rule>
    </RuleSet>
</SyntaxDefinition>

