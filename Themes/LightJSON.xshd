<?xml version="1.0"?>
<SyntaxDefinition name="LightJSON" extensions=".json" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <Color name="Name" foreground="Blue" />
    <Color name="Value" foreground="Red" />
    <Color name="Link" foreground="Purple" />
    <Color name="Punctuation" foreground="Black" />
    <RuleSet>
        <Rule color="Name">&quot;([^&quot;\\]|\\.)*&quot;\s*(?=:)</Rule>
        <Rule color="Link">&quot;https?://([^&quot;\\]|\\.)*&quot;</Rule>
        <Rule color="Value">&quot;([^&quot;\\]|\\.)*&quot;</Rule>
        <Rule color="Value">\b\d+(\.\d+)?([eE][+-]?\d+)?\b</Rule>
        <Rule color="Value">\b(true|false|null)\b</Rule>
        <Rule color="Punctuation">[{},:\[\]]</Rule>
    </RuleSet>
</SyntaxDefinition>

