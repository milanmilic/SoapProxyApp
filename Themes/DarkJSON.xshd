<?xml version="1.0"?>
<SyntaxDefinition name="DarkJSON" extensions=".json" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
    <Color name="Name" foreground="#4EC9B0" />
    <Color name="Value" foreground="#FF7F7F" />
    <Color name="Link" foreground="#569CD6" />
    <Color name="Punctuation" foreground="#D4D4D4" />
    <RuleSet>
        <Rule color="Name">&quot;([^&quot;\\]|\\.)*&quot;\s*(?=:)</Rule>
        <Rule color="Link">&quot;https?://([^&quot;\\]|\\.)*&quot;</Rule>
        <Rule color="Value">&quot;([^&quot;\\]|\\.)*&quot;</Rule>
        <Rule color="Value">\b\d+(\.\d+)?([eE][+-]?\d+)?\b</Rule>
        <Rule color="Value">\b(true|false|null)\b</Rule>
        <Rule color="Punctuation">[{},:\[\]]</Rule>
    </RuleSet>
</SyntaxDefinition>

