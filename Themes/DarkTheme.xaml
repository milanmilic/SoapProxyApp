<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBg" Color="#2D2D30"/>
    <SolidColorBrush x:Key="TextFg" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#2D2D30"/>
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="ItemBg" Color="#252526"/>
    <SolidColorBrush x:Key="ItemSelectedBg" Color="#3F3F46"/>
    <SolidColorBrush x:Key="ItemText" Color="#4DAAFB"/>
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBg" Color="#1E3B20"/> <!-- Dark Pale Green -->
    <SolidColorBrush x:Key="ErrorBg" Color="#4A1C1C"/>   <!-- Dark Pale Red -->
    <SolidColorBrush x:Key="WarningBg" Color="#333333"/> <!-- Dark Gray/Neutral -->
    
    <!-- AvalonEdit Default Editor Colors -->
    <SolidColorBrush x:Key="EditorBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="EditorFg" Color="#D4D4D4"/>
</ResourceDictionary>
