<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#F4F4F9"/>
    <SolidColorBrush x:Key="PanelBg" Color="White"/>
    <SolidColorBrush x:Key="TextFg" Color="#333333"/>
    <SolidColorBrush x:Key="BorderColor" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="ItemBg" Color="White"/>
    <SolidColorBrush x:Key="ItemSelectedBg" Color="#BBE0FF"/>
    <SolidColorBrush x:Key="ItemText" Color="#005A9E"/>
    <SolidColorBrush x:Key="GridLineColor" Color="#D8DEE4"/>
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBg" Color="#DCF2E0"/> <!-- Pale Green -->
    <SolidColorBrush x:Key="ErrorBg" Color="#FADBD8"/>   <!-- Pale Red -->
    <SolidColorBrush x:Key="WarningBg" Color="#FFF3CD"/> <!-- Pale Amber -->
    <SolidColorBrush x:Key="SuccessFg" Color="#1B5E20"/>
    <SolidColorBrush x:Key="ErrorFg" Color="#B71C1C"/>
    
    <!-- AvalonEdit Default Editor Colors -->
    <SolidColorBrush x:Key="EditorBg" Color="White"/>
    <SolidColorBrush x:Key="EditorFg" Color="Black"/>
</ResourceDictionary>
