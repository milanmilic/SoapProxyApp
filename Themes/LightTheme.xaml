<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#F4F4F9"/>
    <SolidColorBrush x:Key="PanelBg" Color="White"/>
    <SolidColorBrush x:Key="TextFg" Color="#333333"/>
    <SolidColorBrush x:Key="BorderColor" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="ItemBg" Color="White"/>
    <SolidColorBrush x:Key="ItemSelectedBg" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="ItemText" Color="#005A9E"/>
    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBg" Color="#E8F5E9"/> <!-- Pale Green -->
    <SolidColorBrush x:Key="ErrorBg" Color="#FFEBEE"/>   <!-- Pale Red -->
    <SolidColorBrush x:Key="WarningBg" Color="#F5F5F5"/> <!-- Pale Gray/Neutral -->
    
    <!-- AvalonEdit Default Editor Colors -->
    <SolidColorBrush x:Key="EditorBg" Color="White"/>
    <SolidColorBrush x:Key="EditorFg" Color="Black"/>
</ResourceDictionary>
